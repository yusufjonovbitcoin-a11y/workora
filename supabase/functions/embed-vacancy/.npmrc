# Configuration for private npm package dependencies
# For more information on using private registries with Edge Functions, see:
# https://supabase.com/docs/guides/functions/import-maps#importing-from-private-registries
import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"

serve(async (req) => {
  const { vacancyId } = await req.json()
  
  const supabase = createClient(
    Deno.env.get('SUPABASE_URL') ?? '',
    Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? ''
  )

  // 1. Vakansiya ma'lumotlarini olish
  const { data: vacancy } = await supabase
    .from('vacancies')
    .select('*')
    .eq('id', vacancyId)
    .single()

  if (!vacancy) return new Response('Not found', { status: 404 })

  // 2. Embedding uchun matn tayyorlash
  const inputText = `Lavozim: ${vacancy.title}. Kompaniya: ${vacancy.company}. Joylashuv: ${vacancy.location}. Maosh: ${vacancy.salary}. Tavsif: ${vacancy.description}.`

  // 3. OpenAI orqali embedding olish
  const response = await fetch('https://api.openai.com/v1/embeddings', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${Deno.env.get('OPENAI_API_KEY')}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      model: 'text-embedding-3-small',
      input: inputText,
    }),
  })

  const { data } = await response.json()
  const embedding = data[0].embedding

  // 4. Bazaga saqlash
  await supabase
    .from('vacancies')
    .update({ embedding })
    .eq('id', vacancyId)

  return new Response(JSON.stringify({ success: true }), { 
    headers: { 'Content-Type': 'application/json' } 
  })
})